{
  "name": "reader",
  "displayName": "Reader",
  "description": "Read TXT novels inside a custom VS Code panel.",
  "version": "0.0.1",
  "publisher": "luostar1024",
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "keywords": [
    "txt",
    "reader",
    "novel",
    "ebook",
    "book"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuoStar1024/Reader-VSCode.git"
  },
  "homepage": "https://github.com/LuoStar1024/Reader-VSCode",
  "bugs": {
    "url": "https://github.com/LuoStar1024/Reader-VSCode/issues"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:reader.openLogPanel",
    "onCommand:reader.addLogs",
    "onView:vscodeReader.logView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "vscodeReaderPanel",
          "title": "日志",
          "icon": "media/logs.svg"
        }
      ]
    },
    "views": {
      "vscodeReaderPanel": [
        {
          "id": "vscodeReader.logView",
          "name": "日志",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "reader.openLogPanel",
        "title": "新建日志",
        "icon": "$(new-file)"
      },
      {
        "command": "reader.addLogs",
        "title": "新增日志",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reader.openLogPanel",
          "when": "view == terminal",
          "group": "navigation@9"
        },
        {
          "command": "reader.openLogPanel",
          "when": "view == vscodeReader.logView",
          "group": "navigation@0"
        },
        {
          "command": "reader.addLogs",
          "when": "view == vscodeReader.logView",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out dist/reader.vsix",
    "publish:vsce": "vsce publish",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^6.0.3"
  }
}
